{
  "name": "dsh-minimal-free-search-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的最小权限免费网页搜索 provider",
  "type": "module",
  "main": "./lib/index.js",
  "exports": "./lib/index.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:live": "node test/live-smoke.mjs",
    "test:host-live": "node test/dsh-host-smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "web-search"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3 <0.3.0"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-web": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.3"
  }
}
